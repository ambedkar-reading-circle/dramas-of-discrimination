{
  "name": "app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "test:scroll": "node scripts/smooth-scroll.mjs",
    "postinstall": "node scripts/patch-flipbook.mjs",
    "test:spread": "node --test src/components/manual-flipbook/engine/spreadPlan.test.ts src/components/manual-flipbook/engine/asciiField.test.ts",
    "test:align": "node --test src/lib/notebook-align/alignment.test.ts",
    "test:flipbook-engine": "node scripts/flipbook-engine.mjs",
    "test:flipbook-react": "node scripts/flipbook-react.mjs",
    "test:manual-visual": "node scripts/manual-flipbook-visual.mjs",
    "test:manual": "node scripts/manual-flipbook.mjs",
    "test:manual-canvas": "node scripts/manual-canvas.mjs",
    "test:grid": "node scripts/notebook-grid.mjs",
    "test:notebook-layers": "node scripts/notebook-layers.mjs",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "^4.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "lenis": "^1.3.27",
    "motion": "^14.2.0",
    "page-flip": "2.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pageflip": "2.0.3",
    "roughjs": "^4.6.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "playwright": "^1.64.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "overrides": {
    "react-pageflip": {
      "page-flip": "$page-flip"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
